# Application
SECRET_KEY=change-me-use-openssl-rand-hex-32
# Boş bırakılırsa SQLite (backend/planner.db) kullanılır.
# PostgreSQL (docker compose --profile postgres):
# DATABASE_URL=postgresql+psycopg2://luma:luma@db:5432/luma

# Storage (local development)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=private_uploads

# Private object storage (production — S3 / Cloudflare R2 compatible)
# STORAGE_BACKEND=s3
# STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_BUCKET=your-private-bucket
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto

# Upload limits
MAX_PHOTO_SIZE_MB=15
MAX_PHOTOS_PER_EVENT=500
UPLOADS_ENABLED=true
UPLOADS_PER_MINUTE=10
SIGNED_URL_EXPIRY_SECONDS=300

# CORS — frontend origin(lerini) virgülle ekleyin
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Yerel monorepo: backend frontend'i birlikte servis eder (tek port 8000)
SERVE_FRONTEND=true
# Production / ayrı frontend deploy: false
# SERVE_FRONTEND=false

# Admin (development only — change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# Optional fixed token for reproducible local dev / tests
# SEED_EVENT_TOKEN=

# QR kodları ve upload linkleri için herkese açık frontend adresi
# Yerel LAN telefon testi: http://192.168.x.x:8000
# Production: https://app.example.com
# PUBLIC_BASE_URL=http://192.168.1.39:8000

# Seed event (ilk kurulum)
SEED_EVENT_NAME=Melisa & Berk

# Veritabanı migration (backend dizininde):
# PYTHONPATH=. alembic upgrade head
