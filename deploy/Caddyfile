{$DOMAIN} {
	encode zstd gzip

	# Signed photo links. The bucket is private: storage only answers requests
	# that carry a valid signature from the API.
	handle /luma-private/* {
		reverse_proxy seaweedfs:8333
	}

	handle {
		reverse_proxy api:8000
	}
}

# www -> main domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
