# VDS üretim ayarları. Kopyala: cp .env.example .env  (.env asla git'e girmez)
# Rastgele değer üretmek için: openssl rand -hex 32

# --- Alan adı ve HTTPS ---
DOMAIN=luma.example.com
ACME_EMAIL=you@example.com

# --- Uygulama ---
SECRET_KEY=
ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_ENABLED=false

# --- Veritabanı (PostgreSQL, sunucunun içinde) ---
POSTGRES_PASSWORD=

# --- Fotoğraf depolama ---
# Varsayılan: SeaweedFS aynı sunucuda (veri sunucunda kalır).
COMPOSE_PROFILES=storage
STORAGE_SECRET_ACCESS_KEY=
# Cloudflare R2 kullanacaksan: COMPOSE_PROFILES satırını boşalt ve şunları doldur
# STORAGE_ENDPOINT=https://HESAP_ID.r2.cloudflarestorage.com
# STORAGE_PUBLIC_ENDPOINT=https://HESAP_ID.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_REGION=auto

# --- E-posta (zorunlu; üretim SMTP olmadan başlamaz) ---
EMAIL_BACKEND=smtp
EMAIL_FROM=Luma <noreply@luma.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- İzleme (isteğe bağlı) ---
SENTRY_DSN=

# --- Sınırlar ---
UPLOADS_ENABLED=true
MAX_PHOTO_SIZE_MB=15
MAX_PHOTOS_PER_EVENT=500

# --- Yedekler ---
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups
