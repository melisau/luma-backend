# Koyeb + Neon + Cloudflare production template.
# Add these values in Koyeb Service > Environment variables and secrets.

SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://NEON_USER:NEON_PASSWORD@NEON_HOST/NEON_DATABASE?sslmode=require

STORAGE_BACKEND=s3
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=luma-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

SERVE_FRONTEND=false
FRONTEND_ORIGINS=https://YOUR_PROJECT.pages.dev
PUBLIC_BASE_URL=https://YOUR_PROJECT.pages.dev
RATE_LIMIT_BACKEND=database
PORT=8000

EMAIL_BACKEND=smtp
EMAIL_FROM=Luma <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENTRY_DSN=

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=strong-admin-password

UPLOADS_ENABLED=true
MAX_PHOTO_SIZE_MB=15
MAX_PHOTOS_PER_EVENT=500
