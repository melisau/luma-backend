# Production örneği — kopyalayıp .env olarak düzenleyin veya platform secret'larına ekleyin.

SECRET_KEY=openssl-rand-hex-32-ile-uretin
DATABASE_URL=postgresql+psycopg2://luma:GUCLU_SIFRE@db:5432/luma

STORAGE_BACKEND=s3
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=luma-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

SERVE_FRONTEND=false
FRONTEND_ORIGINS=https://app.example.com
PUBLIC_BASE_URL=https://app.example.com

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=guclu-admin-sifresi

UPLOADS_ENABLED=true
MAX_PHOTO_SIZE_MB=15
MAX_PHOTOS_PER_EVENT=500
